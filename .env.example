# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=earnings_db
MONGODB_COLLECTION=earnings

# LLM provider selector: ollama | groq | gemini | deepseek
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# DeepSeek (used only when LLM_PROVIDER=deepseek)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_REQUEST_TIMEOUT=120

# Groq (used only when LLM_PROVIDER=groq)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_REQUEST_TIMEOUT=60

# Google Gemini (used only when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_REQUEST_TIMEOUT=120

# Agent pipeline settings
# AGENT_MAX_STEPS=15
